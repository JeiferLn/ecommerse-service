NODE_ENV=development
PORT=4000
# Mismo formato que Prisma; el API lo convierte a postgresql+asyncpg.
DATABASE_URL="postgresql://commerce:commerce@localhost:5432/commerce_ai?schema=public"
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
JWT_SECRET="dev-only-secret-change-me-32-characters-minimum"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
RESET_TOKEN_TTL_SECONDS=3600
# SMTP (opcional en dev; sin configurar los correos se loguean en consola)
# Brevo gratis: smtp-relay.brevo.com:587 - Resend SMTP: smtp.resend.com:465
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Commerce AI SaaS <no-reply@commerce-ai.local>"
COOKIE_SECURE=false
# Cloudflare R2 (obligatorio en production; en development, sin R2 se usa disco local uploads/)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Modo local (solo si no hay R2, y solo fuera de production): URL pública del API y carpeta
API_PUBLIC_URL="http://localhost:4000"
LOCAL_UPLOAD_DIR=
# WhatsApp vía Twilio (credenciales de plataforma; el número por empresa va en WhatsAppConnection)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# En development: true para aceptar POST /whatsapp/webhook sin firma Twilio
TWILIO_SKIP_SIGNATURE=true
# URL pública exacta del webhook (ngrok) para validar X-Twilio-Signature cuando skip=false
# TWILIO_WEBHOOK_URL=https://xxxx.ngrok-free.app/api/v1/whatsapp/webhook
# Número que comparten las tiendas sin número propio (se enruta por #codigo de tienda).
# Se configura en /admin/settings; este valor solo se usa si el panel está vacío.
# TWILIO_SHARED_WHATSAPP_NUMBER=+15554447456
WHATSAPP_AUTO_REPLY_ENABLED=true
WHATSAPP_AUTO_REPLY_TEXT="Gracias por tu mensaje. Te responderemos pronto."
# true = no llamar a Twilio al enviar (útil sin credenciales reales). Fuera de production se puede cambiar en /admin/settings.
WHATSAPP_SIMULATE_SEND=true
# Botones, listas y tarjetas (Twilio Content API). false = todo sale como texto con opciones.
WHATSAPP_INTERACTIVE_ENABLED=true
# Plantilla aprobada por Meta con botón "Pagar" cuya URL termina en {{1}} (token del checkout)
# TWILIO_CHECKOUT_CONTENT_SID=HX...
# IA conversacional — OpenRouter free en development
AI_ENABLED=true
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/free
AI_MAX_PRODUCTS=25
AI_HISTORY_LIMIT=8
AI_FALLBACK_TEXT="Gracias por tu mensaje. En un momento un asesor de la tienda te atenderá por aquí."
AI_HTTP_REFERER=http://localhost:3000
AI_APP_TITLE="Commerce AI SaaS"
WHATSAPP_HANDLER_CHOICE_TEXT='¡Hola! ¿Prefieres que te atienda el asistente virtual (bot) o un asesor de la tienda? Responde "bot" o "asesor".'
WHATSAPP_HANDLER_BOT_CONFIRM_TEXT="Perfecto. Te atiende el asistente virtual. ¿En qué te puedo ayudar?"
WHATSAPP_HANDLER_HUMAN_CONFIRM_TEXT="Listo. Un asesor de la tienda continuará esta conversación por aquí."
# RAG / embeddings — reutiliza OPENROUTER_API_KEY; mock si no hay key
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_TOP_K=4
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=80

# Mercado Pago — app de plataforma (OAuth: cada empresa conecta su cuenta)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Debe coincidir exactamente con Redirect URI de la app (ngrok del API en local)
# MP_REDIRECT_URI=https://xxxx.ngrok-free.app/api/v1/payments/mercadopago/oauth/callback
# Webhook (ngrok en local). Si vacío: API_PUBLIC_URL + /api/v1/payments/mercadopago/webhook
# MP_WEBHOOK_URL=https://xxxx.ngrok-free.app/api/v1/payments/mercadopago/webhook
# Con credenciales de prueba: email del comprador test_user_…@testuser.com (no el vendedor).
# MP_TEST_PAYER_EMAIL=
# En development permite activar un plan sin checkout de Mercado Pago si falla la preferencia.
BILLING_ALLOW_DEV_UPGRADE=false
