generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  owner
  manager
  user
}

enum CompanyType {
  retail
  clothing
  footwear
  accessories
  health_beauty
  technology
  electronics
  home_garden
  food_beverage
  pharmacy
  sports
  toys_kids
  automotive
  jewelry
  furniture
  pets
  books_media
  education
  services
  other
}

model Company {
  id            String                @id @default(cuid())
  name          String
  type          CompanyType
  phone         String?
  contactEmail  String?
  website       String?
  address       String?
  description   String?
  /// ISO 3166-1 alpha-2 (ej. CO, MX)
  countryCode      String?
  /// Ciudad base de la tienda (necesaria para validar envíos locales).
  shippingCity     String?
  /// Departamento / región base de la tienda.
  shippingRegion   String?
  /// local | national | international
  shippingScopes   String[] @default([])
  /// debit_card | credit_card | bank_transfer
  paymentMethods   String[] @default([])
  shippingCarriers String[] @default([])
  banks            String[] @default([])
  ownerId       String                @unique
  owner         User                  @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships   CompanyMembership[]
  invitations   Invitation[]
  categories    Category[]
  products      Product[]
  whatsappConnection WhatsAppConnection?
  mercadoPagoConnection MercadoPagoConnection?
  conversations Conversation[]
  knowledgeDocuments KnowledgeDocument[]
  carts         Cart[]
  orders        Order[]
  subscription  Subscription?
  usageCounters UsageCounter[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

enum MercadoPagoConnectionSource {
  oauth
  manual
}

/// Credenciales de Mercado Pago del comercio (el dinero llega a su cuenta).
model MercadoPagoConnection {
  id              String                       @id @default(cuid())
  companyId       String                       @unique
  company         Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accessToken     String
  refreshToken    String?
  publicKey       String?
  /// User ID del vendedor en Mercado Pago.
  mpUserId        String?
  mpNickname      String?
  mpEmail         String?
  mpFirstName     String?
  mpLastName      String?
  /// Site MP (ej. MCO, MLM, MLA).
  mpSiteId        String?
  tokenExpiresAt  DateTime?
  source          MercadoPagoConnectionSource  @default(manual)
  liveMode        Boolean                      @default(false)
  connectedAt     DateTime                     @default(now())
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
}

model CompanyMembership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      UserRole
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([companyId])
}

model Invitation {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([companyId, email])
}

model User {
  id                 String               @id @default(cuid())
  name               String
  email              String               @unique
  passwordHash       String
  role               UserRole             @default(user)
  ownedCompany       Company?             @relation("CompanyOwner")
  memberships        CompanyMembership[]
  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Registro con plan de pago: la cuenta User/Company se crea solo tras cobro MP.
model PendingRegistration {
  id               String          @id @default(cuid())
  email            String          @unique
  name             String
  passwordHash     String
  companyName      String
  companyType      CompanyType
  countryCode      String
  planCode         PlanCode
  billingInterval  BillingInterval
  mpPreapprovalId  String?
  expiresAt        DateTime
  completedAt      DateTime?
  createdAt        DateTime        @default(now())

  @@index([mpPreapprovalId])
  @@index([expiresAt])
}

enum ProductStatus {
  draft
  active
  archived
}

model Category {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([companyId, slug])
  @@index([companyId])
}

model Product {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  description String?
  status      ProductStatus    @default(draft)
  variants    ProductVariant[]
  images      ProductImage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([categoryId])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String
  name           String
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  stock          Int      @default(0)
  attributes     Json?
  cartItems      CartItem[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([productId, sku])
  @@index([productId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  key       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageStatus {
  received
  sent
  failed
}

enum ConversationHandler {
  pending
  bot
  human
}

enum WhatsAppConnectionMode {
  /// Número de la plataforma compartido por varias tiendas; se enruta por `storeCode`.
  shared
  /// Número propio de la tienda (exclusivo).
  dedicated
}

model WhatsAppConnection {
  id                   String                 @id @default(cuid())
  companyId            String                 @unique
  company              Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Número WhatsApp E.164 sin prefijo whatsapp: (ej. +14155238886). Credenciales Twilio van en env de plataforma.
  /// Único solo entre conexiones `dedicated` (índice parcial en la migración).
  twilioWhatsAppNumber String
  displayPhoneNumber   String?
  mode                 WhatsAppConnectionMode @default(dedicated)
  /// Código que el cliente envía en el número compartido para llegar a esta tienda.
  storeCode            String?                @unique
  isActive             Boolean                @default(true)
  conversations        Conversation[]
  sharedSessions       SharedNumberSession[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([twilioWhatsAppNumber])
}

/// Con qué tienda habla cada cliente en el número compartido.
model SharedNumberSession {
  id           String             @id @default(cuid())
  customerWaId String             @unique
  connectionId String
  connection   WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([connectionId])
}

model Conversation {
  id             String               @id @default(cuid())
  companyId      String
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Null en la conversación de prueba del asistente (no pasa por WhatsApp).
  waConnectionId String?
  waConnection   WhatsAppConnection?  @relation(fields: [waConnectionId], references: [id], onDelete: Cascade)
  customerWaId   String
  customerName  String?
  handler        ConversationHandler  @default(pending)
  /// Conversación de "Prueba tu asistente": fuera del inbox, sin envío por Twilio.
  isPlayground   Boolean              @default(false)
  lastMessageAt  DateTime             @default(now())
  messages       Message[]
  cart           Cart?
  orders         Order[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([waConnectionId, customerWaId])
  @@index([companyId])
  @@index([companyId, lastMessageAt])
  @@index([companyId, handler])
  @@index([companyId, isPlayground])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  wamid          String?
  type           String           @default("text")
  body           String
  status         MessageStatus?
  /// Botones, lista, tarjeta o enlace del bot; o `{ kind: "reply", actionId }` cuando el cliente tocó uno.
  interactive    Json?
  rawPayload     Json?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@index([wamid])
}

/// Contenidos creados en Twilio Content API, reutilizados por hash de su estructura.
model WhatsAppContentTemplate {
  id         String   @id @default(cuid())
  hash       String   @unique
  contentSid String
  kind       String
  createdAt  DateTime @default(now())
}

enum KnowledgeDocumentType {
  faq
  policy
  warranty
  guide
}

enum KnowledgeDocumentStatus {
  draft
  active
  archived
}

/// Documento de conocimiento de la empresa (FAQ, política, garantía, guía).
model KnowledgeDocument {
  id        String                  @id @default(cuid())
  companyId String
  company   Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title     String
  type      KnowledgeDocumentType
  body      String
  status    KnowledgeDocumentStatus @default(draft)
  fileKey   String?
  fileName  String?
  mimeType  String?
  chunks    KnowledgeChunk[]
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@unique([companyId, type])
  @@index([companyId])
  @@index([companyId, status])
}

/// Fragmento indexado con embedding pgvector (dimensión fija 1536).
model KnowledgeChunk {
  id         String            @id @default(cuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// Denormalizado para filtrar por tenant en retrieval SQL.
  companyId  String
  content    String
  chunkIndex Int
  /// pgvector; se escribe/lee con SQL raw.
  embedding  Unsupported("vector")?
  createdAt  DateTime          @default(now())

  @@index([documentId])
  @@index([companyId])
  @@unique([documentId, chunkIndex])
}

enum OrderStatus {
  draft
  confirmed
  awaiting_payment
  paid
  preparing
  shipped
  delivered
  cancelled
}

enum OrderChannel {
  whatsapp
  in_store
}

enum InStorePaymentMethod {
  cash
  card
  transfer
  other
}

/// Carrito abierto por conversación WhatsApp (1:1).
model Cart {
  id               String       @id @default(cuid())
  companyId        String
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversationId   String       @unique
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// true = esperando dirección/datos de envío antes del checkout
  checkoutPending  Boolean      @default(false)
  shippingName     String?
  shippingPhone    String?
  shippingAddress  String?
  shippingCity     String?
  items            CartItem[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([companyId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Order {
  id              String       @id @default(cuid())
  /// Código legible para el cliente (ej. ORD-A1B2C3)
  number          String
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversationId  String?
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  /// WhatsApp del cliente; null en ventas de tienda física.
  customerWaId    String?
  channel         OrderChannel @default(whatsapp)
  /// Solo aplica a ventas `in_store`.
  inStorePaymentMethod InStorePaymentMethod?
  status          OrderStatus  @default(awaiting_payment)
  currency        String       @default("COP")
  subtotal        Decimal      @db.Decimal(12, 2)
  shippingCost    Decimal      @default(0) @db.Decimal(12, 2)
  total           Decimal      @db.Decimal(12, 2)
  shippingName    String?
  shippingPhone   String?
  shippingAddress String?
  shippingCountry String?
  shippingRegion  String?
  shippingCity    String?
  notes           String?
  /// Si true, el stock ya se descontó y al cancelar se repone.
  stockDecremented Boolean     @default(true)
  /// Token opaco para checkout público (/checkout/:token).
  checkoutToken    String?     @unique
  checkoutExpiresAt DateTime?
  /// Preferencia de Mercado Pago (Checkout Pro).
  mpPreferenceId   String?
  /// ID del pago aprobado en Mercado Pago.
  mpPaymentId      String?
  items           OrderItem[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([companyId, number])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, channel])
  @@index([companyId, createdAt])
  @@index([conversationId])
  @@index([customerWaId])
  @@index([mpPaymentId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String?
  productName String
  variantName String
  sku         String
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 2)

  @@index([orderId])
}

enum PlanCode {
  free
  pro
  business
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  trial_expired
  canceled
}

enum BillingInterval {
  month
  year
}

model Plan {
  id                   String   @id @default(cuid())
  code                 PlanCode @unique
  name                 String
  /// Precio de display en centavos USD (0 = free).
  priceUsdCents        Int      @default(0)
  maxMembers           Int
  maxProducts          Int
  maxVariants          Int
  maxWaMessagesMonth   Int
  maxAiRepliesMonth    Int
  maxKnowledgeDocs     Int
  isPublic             Boolean  @default(true)
  sortOrder            Int      @default(0)
  subscriptions        Subscription[] @relation("SubscriptionPlan")
  desiredSubscriptions Subscription[] @relation("DesiredPlan")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Subscription {
  id                      String             @id @default(cuid())
  companyId               String             @unique
  company                 Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId                  String
  plan                    Plan               @relation("SubscriptionPlan", fields: [planId], references: [id])
  status                  SubscriptionStatus @default(trialing)
  trialEndsAt             DateTime?
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  /// Ciclo de facturación activo (null en trial sin plan de pago).
  billingInterval         BillingInterval?
  /// Canceló renovación; acceso hasta currentPeriodEnd.
  cancelAtPeriodEnd       Boolean            @default(false)
  /// Plan de pago elegido en registro/upgrade (pendiente de cobro).
  desiredPlanId           String?
  desiredPlan             Plan?              @relation("DesiredPlan", fields: [desiredPlanId], references: [id])
  desiredBillingInterval  BillingInterval?
  mpPreferenceId          String?
  mpPreapprovalId         String?
  mpPaymentId             String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([status])
  @@index([planId])
  @@index([mpPreapprovalId])
}

model UsageCounter {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Clave UTC YYYY-MM
  periodKey      String
  waInboundCount Int      @default(0)
  aiReplyCount   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, periodKey])
  @@index([companyId])
}
