generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  owner
  manager
  user
}

enum CompanyType {
  retail
  clothing
  footwear
  accessories
  health_beauty
  technology
  electronics
  home_garden
  food_beverage
  pharmacy
  sports
  toys_kids
  automotive
  jewelry
  furniture
  pets
  books_media
  education
  services
  other
}

model Company {
  id            String                @id @default(cuid())
  name          String
  type          CompanyType
  phone         String?
  contactEmail  String?
  website       String?
  address       String?
  description   String?
  /// ISO 3166-1 alpha-2 (ej. CO, MX)
  countryCode      String?
  /// local | national | international
  shippingScopes   String[] @default([])
  /// debit_card | credit_card | bank_transfer
  paymentMethods   String[] @default([])
  shippingCarriers String[] @default([])
  banks            String[] @default([])
  ownerId       String                @unique
  owner         User                  @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships   CompanyMembership[]
  invitations   Invitation[]
  categories    Category[]
  products      Product[]
  whatsappConnection WhatsAppConnection?
  conversations Conversation[]
  knowledgeDocuments KnowledgeDocument[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model CompanyMembership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      UserRole
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([companyId])
}

model Invitation {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([companyId, email])
}

model User {
  id                 String               @id @default(cuid())
  name               String
  email              String               @unique
  passwordHash       String
  role               UserRole             @default(user)
  ownedCompany       Company?             @relation("CompanyOwner")
  memberships        CompanyMembership[]
  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum ProductStatus {
  draft
  active
  archived
}

model Category {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([companyId, slug])
  @@index([companyId])
}

model Product {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  description String?
  status      ProductStatus    @default(draft)
  variants    ProductVariant[]
  images      ProductImage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([categoryId])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String
  name           String
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  stock          Int      @default(0)
  attributes     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([productId, sku])
  @@index([productId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  key       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageStatus {
  received
  sent
  failed
}

enum ConversationHandler {
  pending
  bot
  human
}

model WhatsAppConnection {
  id                   String         @id @default(cuid())
  companyId            String         @unique
  company              Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Número WhatsApp E.164 sin prefijo whatsapp: (ej. +14155238886). Credenciales Twilio van en env de plataforma.
  twilioWhatsAppNumber String         @unique
  displayPhoneNumber   String?
  isActive             Boolean        @default(true)
  conversations        Conversation[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model Conversation {
  id             String               @id @default(cuid())
  companyId      String
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  waConnectionId String
  waConnection   WhatsAppConnection   @relation(fields: [waConnectionId], references: [id], onDelete: Cascade)
  customerWaId   String
  customerName  String?
  handler        ConversationHandler  @default(pending)
  lastMessageAt  DateTime             @default(now())
  messages       Message[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([waConnectionId, customerWaId])
  @@index([companyId])
  @@index([companyId, lastMessageAt])
  @@index([companyId, handler])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  wamid          String?
  type           String           @default("text")
  body           String
  status         MessageStatus?
  rawPayload     Json?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@index([wamid])
}

enum KnowledgeDocumentType {
  faq
  policy
  warranty
  guide
}

enum KnowledgeDocumentStatus {
  draft
  active
  archived
}

/// Documento de conocimiento de la empresa (FAQ, política, garantía, guía).
model KnowledgeDocument {
  id        String                  @id @default(cuid())
  companyId String
  company   Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title     String
  type      KnowledgeDocumentType
  body      String
  status    KnowledgeDocumentStatus @default(draft)
  fileKey   String?
  fileName  String?
  mimeType  String?
  chunks    KnowledgeChunk[]
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@unique([companyId, type])
  @@index([companyId])
  @@index([companyId, status])
}

/// Fragmento indexado con embedding pgvector (dimensión fija 1536).
model KnowledgeChunk {
  id         String            @id @default(cuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// Denormalizado para filtrar por tenant en retrieval SQL.
  companyId  String
  content    String
  chunkIndex Int
  /// pgvector; se escribe/lee con SQL raw.
  embedding  Unsupported("vector")?
  createdAt  DateTime          @default(now())

  @@index([documentId])
  @@index([companyId])
  @@unique([documentId, chunkIndex])
}
